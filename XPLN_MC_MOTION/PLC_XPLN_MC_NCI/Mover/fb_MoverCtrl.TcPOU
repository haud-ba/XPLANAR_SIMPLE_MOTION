<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="fb_MoverCtrl" Id="{e6f5a859-179d-4121-a0cc-1f6aba83c905}" SpecialFunc="None">
    <Declaration><![CDATA[//---------------------------------------------------------------------------------------------------------------
//
//  HAUD 2023.12.18
//
//  - XTS_TRAINING
//  - example project for setting up transport layer
//
//
//  fb_MoverCtrl
//  - accepts orders (E_MOVER_CTRL) via cyclic struct interface to execute
//  - interface struct  to extern control
//
//
//---------------------------------------------------------------------------------------------------------------
// This SOFTWARE is provided as an Exemple by THE PROVIDER "as is" and "with all faults." THE PROVIDER makes no 
// representations or warranties of any kind concerning the safety, suitability, lack of viruses, inaccuracies, 
// typographical errors, or other harmful components of this SOFTWARE. There are inherent dangers in the use of 
// any software, and you are solely responsible for determining whether this SOFTWARE is compatible with your 
// equipment and other software installed on your equipment. You are also solely responsible for the protection 
// of your equipment and backup of your data, and THE PROVIDER will not be liable for any damages you may suffer 
// in connection with using, modifying, or distributing this SOFTWARE.
//---------------------------------------------------------------------------------------------------------------
FUNCTION_BLOCK fb_MoverCtrl EXTENDS fb_Mover
VAR
  // Ctrl and State for executing commands
  _stCtrl           : REFERENCE TO ARRAY[1..MAX_XPLANAR_MOVERS] OF ST_MOVER_CTRL;
  _stState          : REFERENCE TO ARRAY[1..MAX_XPLANAR_MOVERS] OF ST_MOVER_STATE;

  // data structures to use with commands
  _stMoveData       : REFERENCE TO ARRAY[1..MAX_XPLANAR_MOVERS] OF ST_MOVE_DATA;

  // external setpoint generator access to mover
	_pAxis            : POINTER TO ARRAY[1..3] OF AXIS_REF;

  // we are handling virtual axis, that need to be switched on
  _fbPower          : ARRAY[1..3] OF Tc2_MC2.MC_Power;
  _fbReset          : ARRAY[1..3] OF Tc2_MC2.MC_Reset;
  _fbSetPos         : ARRAY[1..3] OF Tc2_MC2.MC_SetPosition; // position is set to 0.0 because the setpoint generator here is hardcoded to relative movement

  // AXIS_REFs are feeding into here
	_stPosVector,
	_stVeloVector,
	_stAccVector		  : MoverVector;	

  _Extfeedback      : MC_PlanarFeedback;
  _ExtOptions       : ST_ExternalSetpointGenerationOptions;

  _eCmd,
  _eCmdOld          : E_MOVER_CTRL;

  _eState           : E_MOVER_STATE;

  _eResult          : E_PROGRESS;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT Check() THEN RETURN; END_IF

// copy to local for debug
_eCmd                         := _stCtrl[_nMoverId].Cmd;

// cyclic check for command change
// get state for cmd
IF (_eCmd <> _eCmdOld)
THEN
  // get matching sdtate for Ctrl.Cmd
  _eState                     := Cmd(_eCmd);
  _eCmdOld                    := _eCmd;
END_IF


CASE _eResult
OF
  E_PROGRESS.PROGRESS_INVALID:
    _stState[_nMoverId].State := E_MOVER_STATE.MOVER_NULL;

  E_PROGRESS.PROGRESS_ERROR:
    _stState[_nMoverId].State := _eState + E_PROGRESS.PROGRESS_ERROR;

  E_PROGRESS.PROGRESS_DONE:
    _stState[_nMoverId].State := _eState + E_PROGRESS.PROGRESS_DONE;

ELSE
  // work in progress
  // update progress for extern use
  _stState[_nMoverId].State   := _eState + _eResult;

  CASE _eState
  OF
    E_MOVER_STATE.MOVER_ENABLE:
      _eResult                := Enable(TRUE);
  
    E_MOVER_STATE.MOVER_DISABLE:
      _eResult                := Disable(TRUE);
  
    E_MOVER_STATE.MOVER_MOVE_TO_POS:
      _eResult                := MoveToPos(TRUE, _stMoveData[_nMoverId]);
  
    E_MOVER_STATE.MOVER_HALT:
      _eResult                := Halt(TRUE, _stMoveData[_nMoverId]);
  
    E_MOVER_STATE.MOVER_RESET:
      _eResult                := Reset(TRUE);

    E_MOVER_STATE.MOVER_EXT_DISABLE_AXIS:
      _eResult          := Ext_DisableAxis(TRUE);
  
    E_MOVER_STATE.MOVER_EXT_ENABLE_AXIS:
      _eResult          := Ext_EnableAxis(TRUE);
  
    E_MOVER_STATE.MOVER_EXT_SET_POSITION:
      _eResult          := Ext_SetPosition(TRUE);
  
    E_MOVER_STATE.MOVER_EXT_START:
      _eResult          := Ext_StartExtSetpointRelative(TRUE);
  
    E_MOVER_STATE.MOVER_EXT_STOP:
      _eResult          := Ext_StopExtSetpoint(TRUE);

  ELSE
      _eResult                := E_PROGRESS.PROGRESS_INVALID;
  END_CASE
END_CASE


]]></ST>
    </Implementation>
    <Folder Name="private" Id="{258f0b35-b05c-4f01-a3fc-edc5df7e8d88}" />
    <Folder Name="properties" Id="{5a8b437b-ee9d-4787-bbec-edf7399fab97}" />
    <Method Name="Check" Id="{2ee4a3ac-6db7-411d-8353-9d32d3803283}" FolderPath="private\">
      <Declaration><![CDATA[METHOD PRIVATE Check : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// The thing that should not be

IF NOT (_nMoverId > 0)
THEN
  _eCheck                     := E_MOVER_CHECK.MOVER_ID_INVALID;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_Mover)
THEN
  _eCheck                     := E_MOVER_CHECK.REFERENCE_AXIS_REF_INVALID;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_stInfo)
THEN
  _eCheck                     := E_MOVER_CHECK.REFERENCE_INFO_INVALID;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_stMoveData)
THEN
  _eCheck                     := E_MOVER_CHECK.REFERENCE_MOVE_DATA_INVALID;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_stCtrl)
THEN
  _eCheck                     := E_MOVER_CHECK.REFERENCE_CTRL_INVALID;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_stState)
THEN
  _eCheck                     := E_MOVER_CHECK.REFERENCE_STATE_INVALID;
  RETURN;
END_IF

IF NOT (_pAxis <> 0)
THEN
  _eCheck                     := E_MOVER_CHECK.POINTER_NCI_AXIS_REF_INVALID;
  RETURN;
END_IF


_eCheck                       := E_MOVER_CHECK.CHECK_DONE;
Check                         := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cmd" Id="{81245bd4-fb55-4d29-8ac8-fd4c2f9ce918}" FolderPath="private\">
      <Declaration><![CDATA[METHOD PRIVATE Cmd : E_MOVER_STATE
VAR_INPUT
  Ctrl      : E_MOVER_CTRL;
END_VAR
VAR_INST
  _eState   : E_MOVER_STATE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Check() THEN Cmd := E_MOVER_STATE.MOVER_NULL;  RETURN; END_IF


CASE Ctrl
OF
  E_MOVER_CTRL.MOVER_ENABLE:
    _eResult          := Enable(FALSE);
    _eState           := E_MOVER_STATE.MOVER_ENABLE;

  E_MOVER_CTRL.MOVER_DISABLE:
    _eResult          := Disable(FALSE);
    _eState           := E_MOVER_STATE.MOVER_DISABLE;

  E_MOVER_CTRL.MOVER_MOVE_TO_POS:
    _eResult          := MoveToPos(FALSE, _stMoveData[_nMoverId]);
    _eState           := E_MOVER_STATE.MOVER_MOVE_TO_POS;

  E_MOVER_CTRL.MOVER_HALT:
    _eResult          := Halt(FALSE, _stMoveData[_nMoverId]);
    _eState           := E_MOVER_STATE.MOVER_HALT;

  E_MOVER_CTRL.MOVER_RESET:
    _eResult          := Reset(FALSE);
    _eState           := E_MOVER_STATE.MOVER_RESET;

  E_MOVER_CTRL.MOVER_EXT_DISABLE_AXIS:
    _eResult          := Ext_DisableAxis(FALSE);
    _eState           := E_MOVER_STATE.MOVER_EXT_DISABLE_AXIS;

  E_MOVER_CTRL.MOVER_EXT_ENABLE_AXIS:
    _eResult          := Ext_EnableAxis(FALSE);
    _eState           := E_MOVER_STATE.MOVER_EXT_ENABLE_AXIS;

  E_MOVER_CTRL.MOVER_EXT_SET_POSITION:
    _eResult          := Ext_SetPosition(FALSE);
    _eState           := E_MOVER_STATE.MOVER_EXT_SET_POSITION;

  E_MOVER_CTRL.MOVER_EXT_START:
    _eResult          := Ext_StartExtSetpointRelative(FALSE);
    _eState           := E_MOVER_STATE.MOVER_EXT_START;

  E_MOVER_CTRL.MOVER_EXT_STOP:
    _eResult          := Ext_StopExtSetpoint(FALSE);
    _eState           := E_MOVER_STATE.MOVER_EXT_STOP;


ELSE
    _eResult          := E_PROGRESS.PROGRESS_INVALID; 
    _eState           := E_MOVER_STATE.MOVER_NULL;
END_CASE

Cmd                   := _eState;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Ctrl" Id="{29b322c2-ac02-482a-9cba-90f106d7a2cf}" FolderPath="properties\">
      <Declaration><![CDATA[PROPERTY Ctrl : REFERENCE TO ARRAY[1..MAX_XPLANAR_MOVERS] OF ST_MOVER_CTRL
]]></Declaration>
