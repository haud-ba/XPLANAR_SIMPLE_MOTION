        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_stCtrl ref= Ctrl;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="Ext_DisableAxis" Id="{d8c80ed5-9fc0-4793-832a-3aea99bc9e69}">
      <Declaration><![CDATA[METHOD Ext_DisableAxis : e_progress // disable the NCI AXIS_REF _pAxis[]
VAR_INPUT
  execute   : BOOL;
END_VAR
VAR_INST
  _nAxis    : uint;
  _nErrorId : UDINT;
  _idx      : UINT;
  _eState   : e_progress;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Execute THEN _eState  := E_PROGRESS.PROGRESS_INIT; END_IF 
IF NOT Check() THEN Ext_DisableAxis  := E_PROGRESS.PROGRESS_ERROR; RETURN; END_IF


CASE _eState
OF
  E_PROGRESS.PROGRESS_INIT:
    IF Execute
    THEN
      _nErrorId               := 0;
      _nAxis                  := 1;
      _eState                 := E_PROGRESS.PROGRESS_BUSY;
    END_IF
END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_BUSY:
    _fbPower[_nAxis].Enable   := FALSE;

    IF NOT (_pAxis^[_nAxis].Status.ControlLoopClosed)
    THEN
      _eState                 := E_PROGRESS.PROGRESS_PREPARE;
    END_IF
    FOR _idx := 1 TO 3
    DO
      _pAxis^[_idx]();
      _fbPower[_idx](
              Axis:= _pAxis^[_idx], 
              Enable:= FALSE, 
              Enable_Positive:= TRUE, 
              Enable_Negative:= TRUE, 
              Override:= , 
              BufferMode:= , 
              Options:= , 
              Status=> , 
              Busy=> , 
              Error=> , 
              ErrorID=> _nErrorId);
    END_FOR

 END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_PREPARE:
    IF (_nAxis > 2)
    THEN
      _eState                 := E_PROGRESS.PROGRESS_DONE;
    ELSE
      _nAxis                  := _nAxis + 1;
      _eState                 := E_PROGRESS.PROGRESS_BUSY;
    END_IF
END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------

Ext_DisableAxis                       := _eState;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Ext_EnableAxis" Id="{22b59b5d-5c68-4855-8064-b947d154e8cf}">
      <Declaration><![CDATA[METHOD Ext_EnableAxis : e_progress // enable the NCI AXIS_REF _pAxis[]
VAR_INPUT
  execute   : BOOL;
END_VAR
VAR_INST
  _nAxis    : uint;
  _nErrorId : UDINT;
  _idx      : UINT;
  _eState   : e_progress;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Execute THEN _eState  := E_PROGRESS.PROGRESS_INIT; END_IF 
IF NOT Check() THEN Ext_EnableAxis  := E_PROGRESS.PROGRESS_ERROR; RETURN; END_IF


CASE _eState
OF
  E_PROGRESS.PROGRESS_INIT:
    IF Execute
    THEN
      _nErrorId               := 0;
      _nAxis                  := 1;
      _eState                 := E_PROGRESS.PROGRESS_BUSY;
    END_IF
END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_BUSY:
    _fbPower[_nAxis].Enable   := TRUE;

    IF (_pAxis^[_nAxis].Status.ControlLoopClosed)
    THEN
      _eState                 := E_PROGRESS.PROGRESS_PREPARE;
    END_IF
    FOR _idx := 1 TO 3
    DO
      _pAxis^[_idx]();
      _fbPower[_idx](
              Axis:= _pAxis^[_idx], 
              Enable:= TRUE, 
              Enable_Positive:= TRUE, 
              Enable_Negative:= TRUE, 
              Override:= 100.0, 
              BufferMode:= , 
              Options:= , 
              Status=> , 
              Busy=> , 
              Error=> , 
              ErrorID=> _nErrorId);
    END_FOR

 END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_PREPARE:
    IF (_nAxis > 2)
    THEN
      _eState                 := E_PROGRESS.PROGRESS_DONE;
    ELSE
      _nAxis                  := _nAxis + 1;
      _eState                 := E_PROGRESS.PROGRESS_BUSY;
    END_IF
END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------

Ext_EnableAxis                       := _eState;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Ext_SetPosition" Id="{d54eb108-ec17-49c8-9635-8fed6ef3a22f}">
      <Declaration><![CDATA[METHOD Ext_SetPosition : e_progress
VAR_INPUT
  Execute             : BOOL;
END_VAR
VAR_INST
  _rSetPos            : ARRAY[1..3] OF LREAL;
  _ndx                : udint;
  _nAxis              : UDINT;
  _nErrorId           : UDINT;
  _eState             : E_PROGRESS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Execute THEN _eState  := E_PROGRESS.PROGRESS_INIT; END_IF 
IF NOT Check() THEN Ext_SetPosition   := E_PROGRESS.PROGRESS_ERROR; RETURN; END_IF


CASE _eState
OF
  E_PROGRESS.PROGRESS_INIT:
    IF Execute
    THEN
      _rSetPos[1]               := 0.0; // these are hardcoded because the setpoint generator is set to relative movement
      _rSetPos[2]               := 0.0;
      _rSetPos[3]               := 0.0;

      _nErrorId                 := 0;
      _nAxis                    := 1;
      _eState                   := E_PROGRESS.PROGRESS_BUSY;

      FOR _ndx := 1 TO 3
      DO
        _fbSetPos[_ndx](
                    Axis:= _pAxis^[_ndx], 
                    Execute:= FALSE, 
                    Position:= 0.0);
      END_FOR
    END_IF
END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_BUSY:
    _fbSetPos[_nAxis](
                Axis:= _pAxis^[_nAxis], 
                Execute:= TRUE, 
                Position:= _rSetPos[_nAxis], 
                Mode:= , 
                Options:= , 
                Done=> , 
                Busy=> , 
                Error=> , 
                ErrorID=> );

    IF _fbSetPos[_nAxis].Done
    THEN
      _eState                 := E_PROGRESS.PROGRESS_PREPARE;
      _fbSetPos[_nAxis](
                Axis:= _pAxis^[_nAxis], 
                Execute:= FALSE);
    END_IF 

  E_PROGRESS.PROGRESS_PREPARE:
    IF (_nAxis > 2)
    THEN
      _eState                 := E_PROGRESS.PROGRESS_DONE;
    ELSE
      _nAxis                  := _nAxis + 1;
      _eState                 := E_PROGRESS.PROGRESS_BUSY;
    END_IF
END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_STARTUP:

  E_PROGRESS.PROGRESS_CHECK:
    _eState                     := E_PROGRESS.PROGRESS_OCCUPIED;

END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_OCCUPIED:

END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_WORKING:
END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_STILL_WORKING:
END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
Ext_SetPosition                       := _eState;
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------]]></ST>
      </Implementation>
    </Method>
    <Method Name="Ext_StartExtSetpointRelative" Id="{8b1da0a8-10cb-468c-8ed6-8de0a8af3b57}">
      <Declaration><![CDATA[METHOD Ext_StartExtSetpointRelative : e_progress
VAR_INPUT
  Execute   : BOOL;
END_VAR
VAR_INST
  _nAxis    : uint;
  _nErrorId : UDINT;
  _idx      : UINT;
  _eState   : e_progress;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Execute THEN _eState                       := E_PROGRESS.PROGRESS_INIT; END_IF 
IF NOT Check() THEN Ext_StartExtSetpointRelative  := E_PROGRESS.PROGRESS_ERROR; RETURN; END_IF


CASE _eState
OF
  E_PROGRESS.PROGRESS_INIT:
    IF Execute
    THEN
      _nErrorId               := 0;
      _nAxis                  := 1;
      _eState                 := E_PROGRESS.PROGRESS_BUSY;
      _ExtOptions.mode        := MC_EXTERNAL_SET_POSITION_MODE.Relative;  // this example runs with relative movement
    END_IF
END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_BUSY:
    _Mover.StartExternalSetpointGeneration(_Extfeedback,_ExtOptions);
    _eState                   := E_PROGRESS.PROGRESS_PREPARE;
END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_PREPARE:
    _Extfeedback.Update();

    IF (_Extfeedback.Done)
    THEN
      _eState                 := E_PROGRESS.PROGRESS_WORKING;

    ELSIF (_Extfeedback.Aborted) OR
          (_Extfeedback.Error)
    THEN
      _nErrorId               := _Extfeedback.ErrorId;
      _eState                 := E_PROGRESS.PROGRESS_ERROR;
    END_IF
END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_working:
    FOR _idx := 1 TO 3
    DO
      _pAxis^[_idx]();
      _fbPower[_idx](
            Axis              := _pAxis^[_idx], 
            Enable_Positive   := TRUE, 
            Enable_Negative   := TRUE, 
            Override          := , 
            BufferMode        := , 
            Options           := , 
            Status            => , 
            Busy              => , 
            Error             => , 
            ErrorID           => );
    END_FOR

    _stPosVector.x 	          := _pAxis^[1].NcToPlc.SetPos;
    _stVeloVector.x	          := _pAxis^[1].NcToPlc.SetVelo;
    _stAccVector.x		        := _pAxis^[1].NcToPlc.SetAcc;
  
    _stPosVector.y 	          := _pAxis^[2].NcToPlc.SetPos;
    _stVeloVector.y	          := _pAxis^[2].NcToPlc.SetVelo;
    _stAccVector.y		        := _pAxis^[2].NcToPlc.SetAcc;
  
    _stPosVector.z 	          := _pAxis^[3].NcToPlc.SetPos;
    _stVeloVector.z	          := _pAxis^[3].NcToPlc.SetVelo;
    _stAccVector.z		        := _pAxis^[3].NcToPlc.SetAcc;
  
    _Mover.SetExternalSetpoint(_stPosVector, _stVeloVector, _stAccVector);
    _Mover.Update();
 END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------

Ext_StartExtSetpointRelative  := _eState;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Ext_StopExtSetpoint" Id="{0e4f1d41-a248-452a-9d75-341df3ffe0c5}">
      <Declaration><![CDATA[METHOD Ext_StopExtSetpoint : e_progress
VAR_INPUT
  Execute   : Bool;
END_VAR
VAR_INST
  _nAxis    : uint;
  _nErrorId : UDINT;
  _idx      : UINT;
  _eState   : e_progress;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Execute THEN _eState               := E_PROGRESS.PROGRESS_INIT; END_IF 
IF NOT Check() THEN Ext_StopExtSetpoint   := E_PROGRESS.PROGRESS_ERROR; RETURN; END_IF


CASE _eState
OF
  E_PROGRESS.PROGRESS_INIT:
    IF Execute
    THEN
      _nErrorId               := 0;
      _nAxis                  := 1;
      _eState                 := E_PROGRESS.PROGRESS_BUSY;
    END_IF
END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_BUSY:
    _Mover.StopExternalSetpointGeneration(_Extfeedback);
    _eState                   := E_PROGRESS.PROGRESS_PREPARE;
END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_PREPARE:
    _Extfeedback.Update();

    IF (_Extfeedback.Done)
    THEN
      _eState               := E_PROGRESS.PROGRESS_DONE;

    ELSIF (_Extfeedback.Aborted) OR
          (_Extfeedback.Error)
    THEN
      _nErrorId             := _Extfeedback.ErrorId;
      _eState               := E_PROGRESS.PROGRESS_ERROR;
    END_IF
END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------

Ext_StopExtSetpoint         := _eState;
]]></ST>
      </Implementation>
    </Method>
